# Copy this file to .env and fill in the value before running the generation step.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Local open-weight generation through Ollama (recommended for privacy)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Source PDFs
DOCUMENTS_DIR=C:\Users\gowth\OneDrive\09-10-2026\Documents

# Local Qdrant configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_chunks

# Local retrieval models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
